<UserControl x:Class="MultiCamApp.Ui.PowerlineFrequencySelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Camera anti-flicker (UVC Power Line Frequency). Applied when preview starts. -->
    <StackPanel>
        <TextBlock x:Name="HeaderText" Style="{StaticResource BodyText}"
                   Foreground="{StaticResource AppForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox x:Name="FrequencyBox" Style="{StaticResource InputComboBoxStyle}"
                  AutomationProperties.LabeledBy="{Binding ElementName=HeaderText}"
                  SelectionChanged="FrequencyBox_SelectionChanged">
            <ComboBoxItem Tag="0"/>
            <ComboBoxItem Tag="50"/>
            <ComboBoxItem Tag="60"/>
            <ComboBoxItem Tag="-1"/>
        </ComboBox>
        <TextBlock x:Name="HintText" Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource AppSecondaryTextBrush}" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
