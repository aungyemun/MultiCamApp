<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-harness CLI: runs the app's own VisualStabilityAuditService on video files (no UI). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MultiCamApp">
      <HintPath>..\..\..\source\MultiCamApp\MultiCamApp\bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\MultiCamApp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
