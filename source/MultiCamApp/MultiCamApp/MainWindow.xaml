<Window x:Class="MultiCamApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MultiCamApp.Ui"
        xmlns:pages="clr-namespace:MultiCamApp.Ui.Pages"
        Title="MultiCamApp"
        MinWidth="1024" MinHeight="640"
        Height="800" Width="1280"
        Background="{StaticResource AppBackgroundBrush}"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ReadableDisabledStopPreviewButtonStyle" TargetType="Button" BasedOn="{StaticResource StopPreviewButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledControlBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource DisabledControlTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource DisabledControlBorderBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadableDisabledRecordStartButtonStyle" TargetType="Button" BasedOn="{StaticResource RecordStartButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledControlBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource DisabledControlTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource DisabledControlBorderBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadableDisabledRecordStopButtonStyle" TargetType="Button" BasedOn="{StaticResource RecordStopButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledControlBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource DisabledControlTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource DisabledControlBorderBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <ui:HeaderBar x:Name="HeaderBarControl" DockPanel.Dock="Top"/>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterBackgroundBrush}"
                BorderThickness="0" Padding="10,8">
            <TextBlock x:Name="FooterText"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource AppForegroundBrush}"/>
        </Border>

        <Grid Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:MainNavigation x:Name="MainNavControl" Grid.Row="0"/>

            <Grid x:Name="RecordingPagePanel" Grid.Row="1" Margin="8,6,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="375" MinWidth="360" MaxWidth="390"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="1"
                        CornerRadius="6" Padding="2">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Setup sections (1-4) scroll; Controls (5) and Status (6) are pinned below so the
                         Start/Stop buttons and elapsed time never scroll out of view during a recording. -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10" MinWidth="320">

                            <Button x:Name="RefreshDevicesBtn" Margin="0,0,0,9"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Click="RefreshDevicesBtn_Click"/>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LayoutSectionTitle" Style="{StaticResource SectionTitleLayout}"/>
                                    <StackPanel x:Name="LayoutPanel"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel x:Name="DeviceSectionPanel">
                                    <TextBlock x:Name="SelectionSectionTitle" Style="{StaticResource SectionTitleSelection}"/>
                                    <StackPanel x:Name="Cam1Block" Margin="0,0,0,10">
                                        <TextBlock x:Name="Cam1Label" Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource AppForegroundBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="Cam1Box" AutomationProperties.LabeledBy="{Binding ElementName=Cam1Label}" Style="{StaticResource InputComboBoxStyle}"
                                                  SelectionChanged="DeviceBox_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel x:Name="Cam2Block" Margin="0,0,0,10" Visibility="Collapsed">
                                        <TextBlock x:Name="Cam2Label" Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource AppForegroundBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="Cam2Box" AutomationProperties.LabeledBy="{Binding ElementName=Cam2Label}" Style="{StaticResource InputComboBoxStyle}"
                                                  SelectionChanged="DeviceBox_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel x:Name="Cam3Block" Margin="0,0,0,10" Visibility="Collapsed">
                                        <TextBlock x:Name="Cam3Label" Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource AppForegroundBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="Cam3Box" AutomationProperties.LabeledBy="{Binding ElementName=Cam3Label}" Style="{StaticResource InputComboBoxStyle}"
                                                  SelectionChanged="DeviceBox_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel x:Name="Cam4Block" Visibility="Collapsed">
                                        <TextBlock x:Name="Cam4Label" Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource AppForegroundBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="Cam4Box" AutomationProperties.LabeledBy="{Binding ElementName=Cam4Label}" Style="{StaticResource InputComboBoxStyle}"
                                                  SelectionChanged="DeviceBox_SelectionChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="VideoSectionTitle" Style="{StaticResource SectionTitleVideo}"/>
                                    <TextBlock x:Name="ResolutionLabel" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource AppForegroundBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ResolutionBox" AutomationProperties.LabeledBy="{Binding ElementName=ResolutionLabel}" Style="{StaticResource InputComboBoxStyle}"
                                              Margin="0,0,0,10"
                                              SelectionChanged="VideoSettings_Changed"/>
                                    <TextBlock x:Name="FpsLabel" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource AppForegroundBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="FpsBox" AutomationProperties.LabeledBy="{Binding ElementName=FpsLabel}" Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="VideoSettings_Changed"/>
                                    <Expander x:Name="AdvancedCameraControlsExpander"
                                              Margin="0,10,0,0"
                                              Foreground="{StaticResource AppForegroundBrush}"
                                              IsExpanded="False">
                                        <Border BorderBrush="{StaticResource BorderBrushMain}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="10"
                                                Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="CameraTargetHeaderText" Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource AppForegroundBrush}"
                                                           FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="AdjustSettingsForText"
                                                           Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource AppSecondaryTextBrush}"
                                                           FontSize="12" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="FocusCameraTargetBox" AutomationProperties.LabeledBy="{Binding ElementName=CameraTargetHeaderText}"
                                                          Style="{StaticResource InputComboBoxStyle}"
                                                          Margin="0,0,0,8"
                                                          SelectionChanged="FocusCameraTargetBox_SelectionChanged"/>
                                                <TextBlock x:Name="FocusExposureScopeNoteText"
                                                           Style="{StaticResource BodyText}"
                                                           FontSize="12" Margin="0,0,0,8"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource AppSecondaryTextBrush}"/>
                                                <CheckBox x:Name="AdvancedAutoFocusCheckBox"
                                                          Margin="0,8,0,0"
                                                          Foreground="{StaticResource AppSecondaryTextBrush}"
                                                          Click="AdvancedAutoFocusCheckBox_Click"/>
                                                <TextBlock x:Name="ManualFocusValueLabelText" Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource AppForegroundBrush}" Margin="0,8,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider x:Name="ManualFocusSlider" AutomationProperties.LabeledBy="{Binding ElementName=ManualFocusValueLabelText}"
                                                            Grid.Column="0"
                                                            Minimum="0"
                                                            Maximum="255"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="False"
                                                            ValueChanged="ManualFocusSlider_ValueChanged"/>
                                                    <TextBox x:Name="ManualFocusValueBox" AutomationProperties.LabeledBy="{Binding ElementName=ManualFocusValueLabelText}"
                                                             Grid.Column="1"
                                                             Margin="8,0,0,0"
                                                             Style="{StaticResource InputTextBoxStyle}"
                                                             TextChanged="ManualFocusValueBox_TextChanged"/>
                                                </Grid>
                                                <TextBlock x:Name="ManualFocusAvailabilityText"
                                                           Style="{StaticResource BodyText}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           Foreground="{StaticResource AppSecondaryTextBrush}"/>
                                                <Button x:Name="ApplyFocusSettingButton"
                                                        Margin="0,10,0,0"
                                                        Style="{StaticResource NeutralButtonStyle}"
                                                        Click="ApplyFocusSettingButton_Click"/>
                                                <Button x:Name="DefaultFocusButton"
                                                        Margin="0,6,0,0"
                                                        Style="{StaticResource NeutralButtonStyle}"
                                                        Click="DefaultFocusButton_Click"/>
                                                <TextBlock x:Name="FocusRestoreStatusText"
                                                           Style="{StaticResource BodyText}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource AppSecondaryTextBrush}"/>

                                                <Separator Margin="0,12,0,8" Background="{StaticResource BorderBrushMain}"/>
                                                <TextBlock x:Name="ExposureControlsHeaderText"
                                                           Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource AppForegroundBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,4"/>
                                                <CheckBox x:Name="AdvancedAutoExposureCheckBox"
                                                          Margin="0,4,0,0"
                                                          Foreground="{StaticResource AppSecondaryTextBrush}"
                                                          IsChecked="False"
                                                          Click="AdvancedAutoExposureCheckBox_Click"/>
                                                <TextBlock x:Name="ManualExposureIndexLabelText"
                                                           Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource AppForegroundBrush}"
                                                           Margin="0,8,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider x:Name="ManualExposureSlider" AutomationProperties.LabeledBy="{Binding ElementName=ManualExposureIndexLabelText}"
                                                            Grid.Column="0"
                                                            Minimum="0"
                                                            Maximum="255"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="False"
                                                            ValueChanged="ManualExposureSlider_ValueChanged"/>
                                                    <TextBox x:Name="ManualExposureValueBox" AutomationProperties.LabeledBy="{Binding ElementName=ManualExposureIndexLabelText}"
                                                             Grid.Column="1"
                                                             Margin="8,0,0,0"
                                                             Style="{StaticResource InputTextBoxStyle}"
                                                             TextChanged="ManualExposureValueBox_TextChanged"/>
                                                </Grid>
                                                <TextBlock x:Name="ManualExposureBestEffortNoteText"
                                                           Style="{StaticResource BodyText}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           Foreground="{StaticResource AppSecondaryTextBrush}"/>
                                                <Button x:Name="ApplyExposureSettingButton"
                                                        Margin="0,10,0,0"
                                                        Style="{StaticResource NeutralButtonStyle}"
                                                        Click="ApplyExposureSettingButton_Click"/>
                                                <Button x:Name="DefaultExposureButton"
                                                        Margin="0,6,0,0"
                                                        Style="{StaticResource NeutralButtonStyle}"
                                                        Click="DefaultExposureButton_Click"/>
                                                <TextBlock x:Name="ExposureStatusText"
                                                           Style="{StaticResource BodyText}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           Foreground="{StaticResource AppSecondaryTextBrush}"/>

                                                <!-- White Balance panel — shown only when WB control is supported -->
                                                <StackPanel x:Name="WbCalibrationPanel" Visibility="Collapsed">
                                                    <Separator Margin="0,12,0,8" Background="{StaticResource BorderBrushMain}"/>
                                                    <TextBlock x:Name="WhiteBalanceHeaderText"
                                                               Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource AppForegroundBrush}"
                                                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="WhiteBalanceKelvinNoteText"
                                                               Style="{StaticResource BodyText}"
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{StaticResource AppSecondaryTextBrush}"
                                                               Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="WbSlider" AutomationProperties.LabeledBy="{Binding ElementName=WhiteBalanceHeaderText}"
                                                                Grid.Column="0"
                                                                Minimum="2000"
                                                                Maximum="9000"
                                                                TickFrequency="100"
                                                                IsSnapToTickEnabled="True"
                                                                IsEnabled="False"
                                                                PreviewMouseLeftButtonUp="WbSlider_CommitValue"
                                                                LostFocus="WbSlider_CommitValue"/>
                                                        <TextBox x:Name="WbValueBox" AutomationProperties.LabeledBy="{Binding ElementName=WhiteBalanceHeaderText}"
                                                                 Grid.Column="1"
                                                                 Margin="8,0,0,0"
                                                                 Style="{StaticResource InputTextBoxStyle}"
                                                                 IsEnabled="False"
                                                                 TextChanged="WbValueBox_TextChanged"/>
                                                    </Grid>
                                                    <TextBlock x:Name="WbStatusText"
                                                               Style="{StaticResource BodyText}"
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               Foreground="{StaticResource AppSecondaryTextBrush}"/>
                                                </StackPanel>

                                                <!-- Anti-flicker (UVC Power Line Frequency) -->
                                                <Separator Margin="0,12,0,8" Background="{StaticResource BorderBrushMain}"/>
                                                <ui:PowerlineFrequencySelector x:Name="PowerlineSelector"/>
                                                <ui:VideoQualitySelector x:Name="QualitySelector" Margin="0,12,0,0"/>

                                                <!-- Environmental Lock section -->
                                                <Separator Margin="0,12,0,8" Background="{StaticResource BorderBrushMain}"/>
                                                <TextBlock x:Name="EnvironmentalLockHeaderText"
                                                           Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource AppForegroundBrush}"
                                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="EnvironmentalLockDescriptionText"
                                                           Style="{StaticResource BodyText}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource AppSecondaryTextBrush}"
                                                           Margin="0,0,0,8"/>
                                                <Button x:Name="LockEnvironmentButton"
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource EnvLockButtonStyle}"
                                                        Click="LockEnvironmentButton_Click"/>
                                                <Button x:Name="OneShotCalibrateButton"
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource EnvLockButtonStyle}"
                                                        Click="OneShotCalibrateButton_Click"/>
                                                <TextBlock x:Name="CalibrationStatusLabel"
                                                           Style="{StaticResource BodyText}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource AppSecondaryTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                    <TextBlock x:Name="VideoSettingsHint" Style="{StaticResource BodyText}"
                                               FontSize="12" Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ConstantFrameCountInfoText" Style="{StaticResource BodyText}"
                                               FontSize="12" Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource AppSecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="OutputSectionTitle" Style="{StaticResource SectionTitleOutput}"/>
                                    <TextBlock x:Name="OutputLabel" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource AppForegroundBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutputBox" AutomationProperties.LabeledBy="{Binding ElementName=OutputLabel}" Grid.Column="0" IsReadOnly="True"
                                                 Style="{StaticResource InputTextBoxStyle}"/>
                                        <Button x:Name="BrowseBtn" Grid.Column="1"
                                                MinWidth="84" Margin="10,0,0,0"
                                                Style="{StaticResource NeutralButtonStyle}"
                                                Click="BrowseBtn_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="SessionLabel" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource AppForegroundBrush}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="SessionBox" AutomationProperties.LabeledBy="{Binding ElementName=SessionLabel}" Style="{StaticResource InputTextBoxStyle}"/>
                                    <TextBlock x:Name="SessionFolderPreviewLabel" Style="{StaticResource BodyText}"
                                               FontSize="12" Margin="0,8,0,4" Opacity="0.85"/>
                                    <TextBlock x:Name="SessionFolderPreviewValue" Style="{StaticResource BodyText}"
                                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource AccentVideoBrush}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="0,1,0,0"
                            Background="{StaticResource PanelBackgroundBrush}">
                        <StackPanel Margin="10,8,10,10" MinWidth="320">
                            <Border Style="{StaticResource SectionCardStyle}" Padding="12,9,12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="ControlsSectionTitle" Style="{StaticResource SectionTitleControls}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="PreviewControlsLabel" Visibility="Collapsed"/>
                                            <Button x:Name="StartPreviewBtn" Style="{StaticResource PreviewButtonStyle}"
                                                    Padding="6,6" Click="StartPreviewBtn_Click"/>
                                            <Button x:Name="StopPreviewBtn" Style="{StaticResource ReadableDisabledStopPreviewButtonStyle}"
                                                    Padding="6,6" Margin="0" Click="StopPreviewBtn_Click"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="RecordingControlsLabel" Visibility="Collapsed"/>
                                            <Button x:Name="StartRecordBtn" Style="{StaticResource ReadableDisabledRecordStartButtonStyle}"
                                                    Padding="6,6" Click="StartRecordBtn_Click"/>
                                            <Button x:Name="StopRecordBtn" Style="{StaticResource ReadableDisabledRecordStopButtonStyle}"
                                                    Padding="6,6" Margin="0" Click="StopRecordBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatusCardStyle}" Padding="12,9,12,8">
                                <StackPanel>
                                    <TextBlock x:Name="StatusSectionTitle" Style="{StaticResource SectionTitleStatus}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Status / preview values can be long ("Recording", localized errors):
                                             they wrap in the left column; timers keep a fixed-width font on the right. -->
                                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource ActiveDotBrush}"
                                                     VerticalAlignment="Top" Margin="0,5,7,0"/>
                                            <TextBlock x:Name="StatusLabel" Grid.Column="1" Style="{StaticResource StatusLabelText}"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock x:Name="StatusValue" Grid.Column="2" Style="{StaticResource StatusValueText}"
                                                       TextWrapping="Wrap" Margin="0"/>
                                        </Grid>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,5" VerticalAlignment="Top">
                                            <TextBlock x:Name="ElapsedLabel" Style="{StaticResource StatusLabelText}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ElapsedValue" Style="{StaticResource StatusValueText}"
                                                       Margin="0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14"/>
                                        </StackPanel>
                                        <!-- Preview state is already shown by Status (Idle / Previewing / Recording) -->
                                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,5" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="PreviewDot" Width="8" Height="8" Fill="{StaticResource ActiveDotBrush}"
                                                     VerticalAlignment="Top" Margin="0,5,7,0"/>
                                            <TextBlock x:Name="PreviewStatusLabel" Grid.Column="1" Style="{StaticResource StatusLabelText}"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock x:Name="PreviewStatusValue" Grid.Column="2" Style="{StaticResource StatusValueText}"
                                                       TextWrapping="Wrap" Margin="0"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,5" VerticalAlignment="Top" Visibility="Collapsed">
                                            <TextBlock x:Name="SessionTimeLabel" Style="{StaticResource StatusLabelText}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SessionTimeValue" Style="{StaticResource StatusValueText}"
                                                       Margin="0" VerticalAlignment="Center" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CamerasLabel" Style="{StaticResource StatusLabelText}" Margin="15,0,6,0"/>
                                            <TextBlock x:Name="CamerasValue" Grid.Column="1" Style="{StaticResource StatusValueText}"
                                                       TextWrapping="Wrap" Margin="0"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock x:Name="PreviewStartupStatusText" Style="{StaticResource BodyText}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Foreground="{StaticResource AppSecondaryTextBrush}"/>
                                    <TextBlock x:Name="MultiCamUsbWarningText" Style="{StaticResource BodyText}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0"
                                               Foreground="{StaticResource AccentVideoBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PreviewCanvasBrush}"
                        BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="1"
                        CornerRadius="6" Padding="6" MinHeight="200">
                    <Grid x:Name="LayoutHost" Background="{StaticResource PreviewCanvasBrush}" MinHeight="200"/>
                </Border>
            </Grid>

            <pages:VideoVerificationPage x:Name="VerificationPage" Grid.Row="1"
                                         Visibility="Collapsed"/>
            <pages:HardwareDiagnosticsPage x:Name="HardwareDiagnosticsPage" Grid.Row="1"
                                           Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
